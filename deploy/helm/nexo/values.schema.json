{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Values of the Nexo chart",
  "type": "object",
  "required": ["mode", "image", "auth", "standalone", "distributed", "persistence"],
  "properties": {
    "mode": {
      "description": "standalone (one pod) or distributed (StatefulSet cluster)",
      "type": "string",
      "enum": ["standalone", "distributed"]
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "clusterDomain": {"type": "string", "minLength": 1},
    "auth": {
      "type": "object",
      "properties": {
        "rootUser": {"type": "string"},
        "rootPassword": {"type": "string"},
        "existingSecret": {"type": "string"},
        "existingSecretUserKey": {"type": "string", "minLength": 1},
        "existingSecretPasswordKey": {"type": "string", "minLength": 1}
      }
    },
    "standalone": {
      "type": "object",
      "properties": {
        "drives": {"type": "integer", "minimum": 1}
      }
    },
    "distributed": {
      "type": "object",
      "properties": {
        "replicas": {"type": "integer", "minimum": 2},
        "drivesPerNode": {"type": "integer", "minimum": 1},
        "pools": {"type": "integer", "minimum": 1},
        "podManagementPolicy": {"type": "string", "enum": ["Parallel", "OrderedReady"]},
        "updateStrategy": {"type": "object"}
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "storageClass": {"type": "string"},
        "accessModes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "size": {"type": ["string", "integer"]},
        "annotations": {"type": "object"},
        "existingClaim": {"type": "string"}
      }
    },
    "cache": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "size": {"type": "string"},
        "memory": {"type": "string"},
        "mode": {"type": "string", "enum": ["", "local", "shared", "shared+local"]},
        "volume": {
          "type": "object",
          "properties": {
            "type": {"type": "string", "enum": ["emptyDir", "pvc"]},
            "medium": {"type": "string", "enum": ["", "Memory"]},
            "size": {"type": ["string", "integer"]},
            "storageClass": {"type": "string"}
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "secretName": {"type": "string"},
        "caSecretName": {"type": "string"},
        "caKey": {"type": "string", "minLength": 1},
        "minVersion": {"type": "string", "enum": ["", "1.2", "1.3"]},
        "internodeVerify": {"type": "boolean"}
      }
    },
    "kms": {
      "type": "object",
      "properties": {
        "secretKey": {"type": "string", "pattern": "^(|[^:]+:[A-Za-z0-9+/=]+)$"},
        "existingSecret": {"type": "string"},
        "existingSecretKey": {"type": "string"},
        "kes": {
          "type": "object",
          "properties": {
            "endpoint": {"type": "string", "pattern": "^(|https://.+)$"},
            "keyName": {"type": "string"},
            "existingSecret": {"type": "string"}
          }
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "region": {"type": "string"},
        "domain": {"type": "string"},
        "serverURL": {"type": "string", "pattern": "^(|https?://.+)$"},
        "browserRedirectURL": {"type": "string", "pattern": "^(|https?://.+)$"},
        "trustedProxies": {"type": "array", "items": {"type": "string"}},
        "forwardedHeaders": {"type": "string", "enum": ["", "x-forwarded", "forwarded"]},
        "logLevel": {"type": "string", "enum": ["", "debug", "info", "warn", "error"]},
        "logFormat": {"type": "string", "enum": ["", "json", "text"]},
        "prometheusAuthType": {"type": "string", "enum": ["", "jwt", "public"]},
        "storageClassStandard": {"type": "string", "pattern": "^(|EC:[0-9]+)$"},
        "storageClassRRS": {"type": "string", "pattern": "^(|EC:[0-9]+)$"},
        "otel": {
          "type": "object",
          "properties": {
            "endpoint": {"type": "string", "pattern": "^(|https?://.+)$"},
            "protocol": {"type": "string", "enum": ["", "http/protobuf", "grpc"]},
            "sampleRatio": {
              "description": "NEXO_OTEL_TRACES_SAMPLER_ARG, 0 to 1 (empty: server default)",
              "anyOf": [
                {"type": "string", "pattern": "^(|0(\\.[0-9]+)?|1(\\.0+)?)$"},
                {"type": "number", "minimum": 0, "maximum": 1}
              ]
            }
          }
        }
      }
    },
    "extraEnv": {"type": "array"},
    "envFrom": {"type": "array"},
    "extraArgs": {"type": "array", "items": {"type": "string"}},
    "service": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "s3Port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "consolePort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "externalTrafficPolicy": {"type": "string", "enum": ["", "Cluster", "Local"]}
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "s3": {"$ref": "#/definitions/ingress"},
        "console": {"$ref": "#/definitions/ingress"},
        "distributions": {"$ref": "#/definitions/ingress"}
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "labels": {"type": "object"},
        "cluster": {"type": "boolean"},
        "bucket": {"type": "boolean"},
        "bearerTokenSecret": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "key": {"type": "string"}
          }
        },
        "relabelings": {"type": "array"},
        "metricRelabelings": {"type": "array"}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "maxUnavailable": {"type": ["integer", "string"]}
      }
    },
    "podAntiAffinity": {"type": "string", "enum": ["", "soft", "hard"]},
    "podAntiAffinityTopologyKey": {"type": "string"},
    "affinity": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "topologySpreadConstraints": {"type": "array"},
    "priorityClassName": {"type": "string"},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
    "resources": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "probes": {"type": "object"},
    "serviceAccount": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "allowedFrom": {"type": "array"}
      }
    },
    "tests": {
      "type": "object",
      "properties": {
        "bucket": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"}
      }
    }
  },
  "definitions": {
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"type": "object"},
        "hosts": {"type": "array", "items": {"type": "string"}},
        "path": {"type": "string"},
        "pathType": {"type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"]},
        "tls": {"type": "array"}
      }
    }
  }
}
