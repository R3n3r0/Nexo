# Nexo container environment. Copy to nexo.env (ignored by git) and edit.
#
#   cp nexo.env.example nexo.env
#
# Root credentials are mandatory (user >= 3 characters, password >= 8).
# For Docker/Swarm secrets use NEXO_ROOT_USER_FILE / NEXO_ROOT_PASSWORD_FILE
# instead: the *_FILE variable wins over the plain one.
NEXO_ROOT_USER=admin
NEXO_ROOT_PASSWORD=change-me-please
#NEXO_ROOT_USER_FILE=/run/secrets/nexo_root_user
#NEXO_ROOT_PASSWORD_FILE=/run/secrets/nexo_root_password

# Listen addresses (defaults). 9000 = S3 API, 9001 = console + Admin API.
#NEXO_ADDRESS=:9000
#NEXO_CONSOLE_ADDRESS=:9001

# Public URLs used by console and CLI to build shareable/presigned links
# when Nexo sits behind a reverse proxy or load balancer.
#NEXO_SERVER_URL=https://s3.example.com
#NEXO_BROWSER_REDIRECT_URL=https://console.example.com

# Reverse proxies whose X-Forwarded-* headers are trusted (IPs or CIDRs,
# comma separated). The compose default network is usually 172.16.0.0/12.
#NEXO_TRUSTED_PROXIES=172.16.0.0/12

# Enable virtual-host style bucket addressing (bucket.s3.example.com).
#NEXO_DOMAIN=s3.example.com

# Default region.
#NEXO_REGION=us-east-1

# TLS: directory with public.crt and private.key (CAs/ for trusted CAs).
# Used by compose.cluster-tls.yml, which mounts ./certs at /certs.
#NEXO_CERTS_DIR=/certs

# Logging: json|text and debug|info|warn|error.
#NEXO_LOG_FORMAT=json
#NEXO_LOG_LEVEL=info

# Prometheus: "jwt" (default, scrape with a bearer token) or "public".
# compose.observability.yml expects "public" unless you configure a token.
#NEXO_PROMETHEUS_AUTH_TYPE=public
