# Nexo container environment. Copy to nexo.env (ignored by git) and edit.
#
#   cp nexo.env.example nexo.env
#
# Root credentials are mandatory (user >= 3 characters, password >= 8).
# For Docker/Swarm secrets use NEXO_ROOT_USER_FILE / NEXO_ROOT_PASSWORD_FILE
# instead: the *_FILE variable wins over the plain one.
NEXO_ROOT_USER=admin
NEXO_ROOT_PASSWORD=change-me-please
#NEXO_ROOT_USER_FILE=/run/secrets/nexo_root_user
#NEXO_ROOT_PASSWORD_FILE=/run/secrets/nexo_root_password

# Listen addresses (defaults). 9000 = S3 API, 9001 = console + Admin API.
#NEXO_ADDRESS=:9000
#NEXO_CONSOLE_ADDRESS=:9001

# Public URLs used by console and CLI to build shareable/presigned links
# when Nexo sits behind a reverse proxy or load balancer.
#NEXO_SERVER_URL=https://s3.example.com
#NEXO_BROWSER_REDIRECT_URL=https://console.example.com

# Reverse proxies whose X-Forwarded-* headers are trusted (IPs or CIDRs,
# comma separated). The compose default network is usually 172.16.0.0/12.
#NEXO_TRUSTED_PROXIES=172.16.0.0/12

# Enable virtual-host style bucket addressing (bucket.s3.example.com).
#NEXO_DOMAIN=s3.example.com

# Default region.
#NEXO_REGION=us-east-1

# TLS: directory with public.crt and private.key (CAs/ for trusted CAs).
# Used by compose.cluster-tls.yml, which mounts ./certs at /certs.
#NEXO_CERTS_DIR=/certs

# Logging: json|text and debug|info|warn|error.
#NEXO_LOG_FORMAT=json
#NEXO_LOG_LEVEL=info

# Prometheus: "jwt" (default, scrape with a bearer token) or "public".
# compose.observability.yml expects "public" unless you configure a token.
#NEXO_PROMETHEUS_AUTH_TYPE=public

# Erasure coding (SNMD and cluster): parity of the storage classes as EC:n
# (default STANDARD: 2 for sets of up to 5 drives, 3 for 6-7, 4 from 8;
# REDUCED_REDUNDANCY: 1). At most half the drives of an erasure set.
#NEXO_STORAGE_CLASS_STANDARD=EC:4
#NEXO_STORAGE_CLASS_RRS=EC:2

# Cluster internode protocol (defaults): how long the lock of a node that
# stopped refreshing it survives, how often a held lock is refreshed, and
# how long an internode call may take.
#NEXO_LOCK_STALE_AFTER=60s
#NEXO_LOCK_REFRESH_INTERVAL=10s
#NEXO_RPC_CALL_TIMEOUT=30s

# Background healing (erasure-coded modes): longest delay between two
# attempts at an object written while a drive or a node was down (the
# delay doubles from 1s up to this value).
#NEXO_HEAL_RETRY_MAX_DELAY=5m

# Object downloads: how long a client may stop reading a response body
# before it is aborted (releasing the read lock of the object).
#NEXO_SEND_TIMEOUT=20s

# Server-side encryption (docs/07 §7.2). Builtin KMS: the master key,
# "<key-name>:<base64 of 32 random bytes>" (openssl rand -base64 32); the
# key name is the default key of SSE-S3. Prefer the _FILE variant.
#NEXO_KMS_SECRET_KEY=nexo-key:REPLACE-WITH-BASE64-OF-32-BYTES
#NEXO_KMS_SECRET_KEY_FILE=/run/secrets/nexo-kms-key
# Master key rotation: the replaced keys (comma separated) keep the objects
# they sealed readable until `nexoctl admin kms reseal ALIAS` re-seals
# them under the current key; then remove this variable.
#NEXO_KMS_SECRET_KEY_PREVIOUS=old-key:BASE64-OF-THE-PREVIOUS-KEY

# External KMS (KES) instead of the builtin one: https endpoints only
# (comma separated, tried in order) and mutual TLS.
#NEXO_KMS_ENDPOINT=https://kes1.example.net:7373,https://kes2.example.net:7373
#NEXO_KMS_KEY_NAME=nexo-default
#NEXO_KMS_CLIENT_CERT=/etc/nexo/kes/client.crt
#NEXO_KMS_CLIENT_KEY=/etc/nexo/kes/client.key
#NEXO_KMS_CAPATH=/etc/nexo/kes/ca.crt

# SSE-C over plain HTTP: tests and development only (S3 requires TLS).
#NEXO_SSEC_ALLOW_INSECURE=off

# Cache of the distributions (docs/11). The compose files mount a volume at
# /cache for its disk tier (an SSD/NVMe separate from the data drives);
# without NEXO_CACHE_DIR only the memory tier is used. Sizes accept KiB,
# MiB, GiB, TiB (and KB, MB, GB, TB). Mode of a cluster: local (one cache
# per node), shared (one owner node per object) or shared+local.
#NEXO_CACHE_DIR=/cache
#NEXO_CACHE_SIZE=10GiB
#NEXO_CACHE_MEMORY=256MiB
#NEXO_CACHE_MODE=local
