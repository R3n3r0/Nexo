# Release image for ghcr.io/r3n3r0/nexo, built by GoReleaser (.goreleaser.yaml)
# from the already compiled binaries: the build context only contains "nexo"
# and "nexoctl" for the target architecture. For local builds from sources
# use the Dockerfile at the repository root instead.
FROM --platform=$BUILDPLATFORM busybox:1.37-musl AS dirs
RUN mkdir -p /out/data

FROM gcr.io/distroless/static-debian12:nonroot

LABEL org.opencontainers.image.title="Nexo" \
      org.opencontainers.image.description="S3-compatible object storage server with embedded web console" \
      org.opencontainers.image.url="https://github.com/r3n3r0/nexo" \
      org.opencontainers.image.source="https://github.com/r3n3r0/nexo" \
      org.opencontainers.image.vendor="r3n3r0"

COPY nexo /nexo
COPY nexoctl /nexoctl
COPY --from=dirs --chown=65532:65532 /out/data /data

USER 65532:65532
EXPOSE 9000 9001
VOLUME /data
ENV NEXO_ADDRESS=:9000 \
    NEXO_CONSOLE_ADDRESS=:9001
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD ["/nexo", "healthcheck"]
ENTRYPOINT ["/nexo"]
CMD ["server", "/data"]
