          "refId": "A",
          "expr": "sum(rate(nexo_s3_requests_4xx_errors_total{job=\"nexo-node\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "4xx"
        },
        {
          "refId": "B",
          "expr": "sum(rate(nexo_s3_requests_5xx_errors_total{job=\"nexo-node\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "5xx"
