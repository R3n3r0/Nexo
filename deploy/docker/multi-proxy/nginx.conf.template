# Edge A of compose.multi-proxy.yml: nginx in front of the 4 nodes for the
# domains *.alpha.example. Rendered by the nginx image into
# /etc/nginx/conf.d/default.conf (http context): envsubst replaces the
# variable NEXO_ORIGIN_SECRET below with the origin secret of this proxy.
#
#   s3.alpha.example        S3 API (NEXO_SERVER_URL)
#   console.alpha.example   console + Admin API
#   *.alpha.example         distributions: Nexo routes them on the Host header
#
# The client reaches Nexo in X-Forwarded-For/Proto/Host (this proxy is in
# NEXO_TRUSTED_PROXIES); the Host header is forwarded unchanged, with its
# port (SigV4, presigned URLs, routing of the distributions); bodies are
# never limited nor buffered.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

# Node addresses re-resolved through the Docker DNS: a recreated container
# (new address) is picked up without restarting nginx (nginx >= 1.27.3).
upstream nexo_s3 {
    zone nexo_s3 64k;
    resolver 127.0.0.11 valid=10s;
    least_conn;
    server nexo1:9000 resolve max_fails=3 fail_timeout=10s;
    server nexo2:9000 resolve max_fails=3 fail_timeout=10s;
    server nexo3:9000 resolve max_fails=3 fail_timeout=10s;
    server nexo4:9000 resolve max_fails=3 fail_timeout=10s;
    keepalive 64;
}

upstream nexo_console {
    zone nexo_console 64k;
    resolver 127.0.0.11 valid=10s;
    least_conn;
    server nexo1:9001 resolve max_fails=3 fail_timeout=10s;
    server nexo2:9001 resolve max_fails=3 fail_timeout=10s;
    server nexo3:9001 resolve max_fails=3 fail_timeout=10s;
    server nexo4:9001 resolve max_fails=3 fail_timeout=10s;
    keepalive 16;
}

client_max_body_size    0;
proxy_request_buffering off;
proxy_buffering         off;
proxy_http_version      1.1;
ignore_invalid_headers  off;
proxy_connect_timeout   5s;
proxy_send_timeout      300s;
proxy_read_timeout      300s;
# A node stopped or restarting: the request goes to another one (never a
# POST already sent).
proxy_next_upstream       error timeout http_502 http_503 http_504;
proxy_next_upstream_tries 3;
server_tokens             off;

ssl_certificate     /etc/nginx/certs/fullchain.pem;
ssl_certificate_key /etc/nginx/certs/privkey.pem;
ssl_protocols       TLSv1.2 TLSv1.3;
ssl_session_cache   shared:nexo_ssl:10m;

# Hosts of other domains: this proxy serves *.alpha.example only.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name _;
    return 421;
}

# S3 API
server {
    listen 80;
    listen 443 ssl;
    http2 on;
    server_name s3.alpha.example;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header Forwarded         "";
    proxy_set_header Connection        "";

    # The internode RPC only travels between the nodes.
    location ^~ /nexo/rpc/ {
        return 404;
    }
    location / {
        proxy_pass http://nexo_s3;
    }
}

# Console + Admin API (SSE/WebSocket for live logs and traces).
server {
    listen 80;
    listen 443 ssl;
    http2 on;
    server_name console.alpha.example;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header Forwarded         "";
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;

    location / {
        proxy_pass         http://nexo_console;
        proxy_read_timeout 3600s;
    }
}

# Distributions: every other host of the domain. The origin secret of
# this proxy replaces any value a client sends; a distribution that lists
# ${secret:proxy-a} accepts the request, a node reached directly refuses
# it (403).
server {
    listen 80;
    listen 443 ssl;
    http2 on;
    server_name alpha.example *.alpha.example;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header Forwarded         "";
    proxy_set_header Connection        "";
    proxy_set_header X-Origin-Secret   "${NEXO_ORIGIN_SECRET}";

    # The internode RPC is never exposed, on any domain.
    location ^~ /nexo/rpc/ {
        return 404;
    }
    location / {
        proxy_pass http://nexo_s3;
    }
}
