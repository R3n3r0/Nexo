# Release image docker.io/paolor/nexoctl, built by GoReleaser (dockers_v2 in
# .goreleaser.yaml) with buildx for linux/amd64 and linux/arm64 from the
# already compiled binary ($TARGETPLATFORM/nexoctl in the build context).
# For a build from the sources use Dockerfile.nexoctl at the repository
# root, which produces the same image.

# Home directory for ~/.nexoctl/config.json, owned by nonroot.
FROM --platform=$BUILDPLATFORM busybox:1.37-musl AS dirs
RUN mkdir -p /out/home/nonroot

FROM gcr.io/distroless/static-debian12:nonroot

ARG TARGETPLATFORM

LABEL org.opencontainers.image.title="nexoctl" \
      org.opencontainers.image.description="Command-line client for Nexo, the S3-compatible object storage server" \
      org.opencontainers.image.url="https://github.com/r3n3r0/nexo" \
      org.opencontainers.image.documentation="https://github.com/r3n3r0/nexo/tree/main/docs" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.vendor="r3n3r0"

COPY LICENSE NOTICE COMMERCIAL-LICENSE.md /
COPY $TARGETPLATFORM/nexoctl /nexoctl
COPY --from=dirs --chown=65532:65532 /out/home/nonroot /home/nonroot

USER 65532:65532
WORKDIR /home/nonroot
ENV HOME=/home/nonroot

ENTRYPOINT ["/nexoctl"]
CMD ["--help"]
