# Environment of the media worker (compose.media-worker.yml, deploy/swarm).
# Copy to media-worker.env (ignored by git) and fill the three secrets:
#
#   cp media-worker.env.example media-worker.env
#   sed -i "s|^NEXO_WORKER_SECRET_KEY=.*|NEXO_WORKER_SECRET_KEY=$(openssl rand -hex 24)|; s|^NEXO_WORKER_AUTH_TOKEN=.*|NEXO_WORKER_AUTH_TOKEN=$(openssl rand -hex 32)|" media-worker.env
#
# The setup service creates the user NEXO_WORKER_ACCESS_KEY with this secret
# key and the least-privilege policy (media-worker-policy.json), and sets the
# notify_media_worker target of Nexo with this token: change a value and run
# "docker compose ... up -d" again to apply it (the setup is idempotent).

# Credentials of the worker on the S3 API of Nexo (secret key: at least 8
# characters).
NEXO_WORKER_ACCESS_KEY=media-worker
NEXO_WORKER_SECRET_KEY=
# Bearer token of the jobs endpoint, shared with the notify_media_worker target.
NEXO_WORKER_AUTH_TOKEN=

# Jobs processed at once (each one already uses every core); every job needs
# about 1 GiB (video) or 2 GiB (image) of memory.
#NEXO_WORKER_CONCURRENCY=1
# Memory budget of the image variants encoded at once, in bytes (default 2 GiB).
#NEXO_WORKER_IMAGE_MEMORY=2147483648
# A libopenh264 2.4.1 already present in the container (mount it); by default
# the Cisco build is downloaded into the data volume at the first start.
#NEXO_WORKER_OPENH264=/opt/openh264/libopenh264-2.4.1-linux64.7.so
#NEXO_WORKER_LOG_LEVEL=info
#NEXO_WORKER_LOG_FORMAT=json
