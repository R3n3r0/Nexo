# /etc/nexo/nexo.env — environment of the nexo systemd service.
# Keep it readable only by root and the nexo group (0640): it holds secrets.
#
# Root credentials (mandatory: user >= 3 characters, password >= 8), or the
# *_FILE variants pointing to files containing them.
NEXO_ROOT_USER=admin
NEXO_ROOT_PASSWORD=change-me-please
#NEXO_ROOT_USER_FILE=/etc/nexo/root-user
#NEXO_ROOT_PASSWORD_FILE=/etc/nexo/root-password

# Endpoints: the deployment mode is derived from them.
#   single node, single drive:  /srv/nexo
#   single node, multi drive:   /mnt/disk{1...4}
#   cluster (same on every node): http://nexo{1...4}.lan:9000/mnt/disk{1...4}
# Separate several endpoints with spaces.
NEXO_ENDPOINTS=/srv/nexo

# Listen addresses (defaults).
#NEXO_ADDRESS=:9000
#NEXO_CONSOLE_ADDRESS=:9001

# Public URLs behind a reverse proxy (presigned/share links, console redirect).
#NEXO_SERVER_URL=https://s3.example.com
#NEXO_BROWSER_REDIRECT_URL=https://console.example.com
#NEXO_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# Virtual-host style buckets (bucket.s3.example.com).
#NEXO_DOMAIN=s3.example.com

# TLS: directory containing public.crt and private.key (CAs/ for trusted CAs).
#NEXO_CERTS_DIR=/etc/nexo/certs

# Region and logging.
#NEXO_REGION=us-east-1
#NEXO_LOG_FORMAT=json
#NEXO_LOG_LEVEL=info

# Cache of the distributions (docs/11): disk tier on a fast disk separate
# from the data drives (writable by the nexo user); memory only without it.
#NEXO_CACHE_DIR=/var/cache/nexo
#NEXO_CACHE_SIZE=10GiB
#NEXO_CACHE_MEMORY=256MiB
#NEXO_CACHE_MODE=local
