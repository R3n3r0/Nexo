# /etc/default/nexo — environment of the nexo systemd service (nexo.service).
#
# Installed by the deb/rpm packages (kept on upgrades: your edits win). It
# holds secrets: keep it owned by root:nexo with mode 0640.
#
# Every server option is also available as NEXO_<OPTION> (nexo server --help);
# values are taken literally (no shell expansion): quote a value only when
# it contains spaces.

# Root credentials (mandatory: user >= 3 characters, password >= 8). The
# password is empty on purpose: the service refuses to start until it is
# set. Or use the *_FILE variants pointing to files readable by nexo only.
NEXO_ROOT_USER=admin
NEXO_ROOT_PASSWORD=
#NEXO_ROOT_USER_FILE=/etc/nexo/root-user
#NEXO_ROOT_PASSWORD_FILE=/etc/nexo/root-password

# Endpoints: the deployment mode is derived from them (docs/08 §8.1).
#   single node, single drive:  /var/lib/nexo/data
#   single node, multi drive:   /mnt/disk{1...4}
#   cluster (same value on every node): http://nexo{1...4}.lan:9000/mnt/disk{1...4}
#   cluster with two pools:     "http://nexo{1...4}.lan:9000/mnt/disk{1...4} http://nexo{5...8}.lan:9000/mnt/disk{1...4}"
# The unit makes the file system read-only except /var/lib/nexo and
# /var/cache/nexo: drives elsewhere need a drop-in (systemctl edit nexo)
#   [Service]
#   ReadWritePaths=/mnt/disk1 /mnt/disk2 /mnt/disk3 /mnt/disk4
# and must be owned by nexo (install -d -o nexo -g nexo -m 0750 /mnt/disk1).
NEXO_ENDPOINTS=/var/lib/nexo/data

# Listen addresses (defaults). 9000: S3 API and internode RPC (cluster),
# 9001: console and Admin API.
#NEXO_ADDRESS=:9000
#NEXO_CONSOLE_ADDRESS=:9001

# Public URLs behind a reverse proxy (presigned/share links, console redirect).
#NEXO_SERVER_URL=https://s3.example.com
#NEXO_BROWSER_REDIRECT_URL=https://console.example.com
#NEXO_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
# Header family the trusted proxies describe the client with: x-forwarded
# (default) or forwarded (RFC 7239).
#NEXO_FORWARDED_HEADERS=x-forwarded
# Route on X-Forwarded-Host instead of the Host header (only for proxies
# that rewrite the Host; off by default).
#NEXO_TRUST_FORWARDED_HOST=false

# Virtual-host style buckets (bucket.s3.example.com).
#NEXO_DOMAIN=s3.example.com

# TLS: directory containing public.crt and private.key (CAs/ for trusted
# CAs), readable by nexo; systemctl reload nexo reloads them. In a cluster
# the endpoints become https:// and every node certificate must cover the
# host names of the endpoints.
#NEXO_CERTS_DIR=/etc/nexo/certs
#NEXO_TLS_MIN_VERSION=1.2
#NEXO_TLS_INTERNODE_VERIFY=false

# Region and logging (the journal adds timestamps: text or json).
#NEXO_REGION=us-east-1
#NEXO_LOG_FORMAT=json
#NEXO_LOG_LEVEL=info

# Prometheus endpoints (/nexo/metrics/v1/*): "jwt" (default, bearer token
# from nexoctl admin prometheus generate) or "public".
#NEXO_PROMETHEUS_AUTH_TYPE=jwt

# Erasure coding (SNMD and cluster): parity of the storage classes.
#NEXO_STORAGE_CLASS_STANDARD=EC:4
#NEXO_STORAGE_CLASS_RRS=EC:2

# Server-side encryption with the builtin KMS: "<key-name>:<base64 of 32
# random bytes>" (openssl rand -base64 32); prefer the _FILE variant.
#NEXO_KMS_SECRET_KEY_FILE=/etc/nexo/kms-key

# Cache of the distributions (docs/11): disk tier on a fast disk separate
# from the data drives; /var/cache/nexo is created by the unit.
#NEXO_CACHE_DIR=/var/cache/nexo
#NEXO_CACHE_SIZE=10GiB
#NEXO_CACHE_MEMORY=256MiB
#NEXO_CACHE_MODE=local
# Internal networks the purge webhooks may reach (only public addresses
# by default); webhook secrets are NEXO_SECRET_WEBHOOK_<NAME>.
#NEXO_CACHE_WEBHOOK_ALLOW=10.0.0.0/8

# OpenTelemetry tracing (OTLP exporter).
#NEXO_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
#NEXO_OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Share of the traces recorded (0 to 1, default 1).
#NEXO_OTEL_TRACES_SAMPLER_ARG=0.1
