# systemd unit of the Nexo S3-compatible object storage server.
#
# Installed by the deb/rpm packages as /usr/lib/systemd/system/nexo.service;
# for a manual install see deploy/systemd/README.md. The deployment mode
# (SNSD, SNMD, cluster) comes from NEXO_ENDPOINTS in /etc/default/nexo, so
# the unit is the same on every node of every mode.
#
# The executable is looked up by name in systemd's fixed search path
# (/usr/local/bin before /usr/bin, systemd >= 239): the same unit runs the
# packaged binary (/usr/bin/nexo) and a manually installed one
# (/usr/local/bin/nexo).
#
# Local changes go in a drop-in (systemctl edit nexo), never in this file:
# e.g. the data drives outside /var/lib/nexo must be made writable with
#   [Service]
#   ReadWritePaths=/mnt/disk1 /mnt/disk2 /mnt/disk3 /mnt/disk4

[Unit]
Description=Nexo S3-compatible object storage server
Documentation=https://github.com/r3n3r0/nexo/blob/main/docs/08-modalita-deploy.md
Wants=network-online.target
After=network-online.target
# Restart=always below, but a configuration that keeps failing stops after
# 10 attempts in 5 minutes (systemctl reset-failed nexo to retry).
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
# exec, not notify: a cluster node is ready only once enough nodes have
# started (bootstrap); a readiness notification would block "systemctl
# start" on the first nodes. Wait with "nexo healthcheck --ready" instead.
Type=exec
User=nexo
Group=nexo
EnvironmentFile=/etc/default/nexo
# /var/lib/nexo (default drive /var/lib/nexo/data) and /var/cache/nexo
# (NEXO_CACHE_DIR) are created and owned by nexo, and writable despite
# ProtectSystem=strict.
StateDirectory=nexo
StateDirectoryMode=0750
CacheDirectory=nexo
CacheDirectoryMode=0750
WorkingDirectory=/var/lib/nexo

# Validate topology, drive permissions, ports and certificates (with the
# same sandbox as the server) before starting.
ExecStartPre=nexo server --dry-run
ExecStart=nexo server
# SIGHUP reloads the TLS certificates of NEXO_CERTS_DIR.
ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=5s
# SIGTERM: the node answers 503 to new requests and lets the in-flight
# uploads complete before exiting.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=90s

LimitNOFILE=1048576
TasksMax=infinity
OOMScoreAdjust=-500
# Objects, metadata and caches are readable by the nexo user only.
UMask=0077

# Sandbox. The whole file system is read-only except the state and cache
# directories above and the ReadWritePaths of a drop-in.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
# AF_NETLINK: the node lists its interface addresses to recognize its own
# endpoints in a cluster.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# No capability at all. Ports below 1024 (e.g. NEXO_WEB_ADDRESS=:80) need,
# in a drop-in:
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
