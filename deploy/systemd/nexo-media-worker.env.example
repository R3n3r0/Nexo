# /etc/default/nexo-media-worker — environment of nexo-media-worker.service.
#
# Installed by the nexo-media-worker deb/rpm package (kept on upgrades: your
# edits win). It holds secrets: keep it owned by root with mode 0600 (the
# unit reads it as root before dropping to its dynamic user).
#
# Every flag of nexo-media-worker is also NEXO_WORKER_<FLAG>
# (nexo-media-worker --help); values are taken literally (no shell
# expansion). The worker refuses to start until the four required values
# below are set. See docs/user/media-worker.md, "Setup".

# URL of the S3 API of Nexo (a node, or the load balancer of a cluster).
NEXO_WORKER_S3_ENDPOINT=http://127.0.0.1:9000
# Credentials of the user of the worker in Nexo, with the least-privilege
# policy of the documentation (nexoctl admin policy create / user add).
NEXO_WORKER_ACCESS_KEY=media-worker
NEXO_WORKER_SECRET_KEY=
# Bearer token of the jobs endpoint: the auth_token of the
# notify_media_worker target of Nexo (openssl rand -hex 32).
NEXO_WORKER_AUTH_TOKEN=

# Jobs endpoint, the endpoint of the target: http://<this host>:9600/jobs.
# Reachable by Nexo only (firewall, or 127.0.0.1:9600 on the same machine).
NEXO_WORKER_ADDRESS=:9600
# The state directory of the unit: job queue, work files, OpenH264.
NEXO_WORKER_DATA_DIR=/var/lib/nexo-media-worker

# Jobs processed at once (each job uses every core): about 1 GiB of memory
# per video job, 2 GiB per image job.
#NEXO_WORKER_CONCURRENCY=1
# Memory budget of the image variants encoded at once, in bytes (2 GiB).
#NEXO_WORKER_IMAGE_MEMORY=2147483648
# A libopenh264 2.4.1 already on the machine (nexo-media-worker
# fetch-openh264 --dir <dir> on a connected machine); by default the Cisco
# build is downloaded into the data directory at the first start.
#NEXO_WORKER_OPENH264=/usr/local/lib/libopenh264-2.4.1-linux64.7.so
#NEXO_WORKER_S3_REGION=us-east-1
# Logs: the journal adds timestamps (text or json).
#NEXO_WORKER_LOG_LEVEL=info
#NEXO_WORKER_LOG_FORMAT=text

# Automatic subtitles (docs/user/media-worker.md#subtitles): an OpenAI-compatible
# transcription endpoint and a translation endpoint (LibreTranslate, or "chat"
# for OpenAI-compatible chat completions). The audio and the text of the videos
# go to these services: prefer self-hosted ones for private content.
#NEXO_WORKER_TRANSCRIBE_URL=http://whisper:8080/inference
#NEXO_WORKER_TRANSCRIBE_MODEL=whisper-1
#NEXO_WORKER_TRANSCRIBE_KEY=
#NEXO_WORKER_TRANSLATE_URL=http://libretranslate:5000/translate
#NEXO_WORKER_TRANSLATE_ENGINE=libretranslate
#NEXO_WORKER_TRANSLATE_MODEL=
#NEXO_WORKER_TRANSLATE_KEY=
