$ nexoctl media protection set mem/courses --enable --disable
! nexoctl: error: --enable and --disable are exclusive
! Run 'nexoctl media protection set --help' for usage.
[exit 2]

$ nexoctl media protection set mem/courses --max-sessions 0
! nexoctl: error: --max-sessions: expected 1 to 100 or unlimited, got "0"
! Run 'nexoctl media protection set --help' for usage.
[exit 2]

$ nexoctl media protection set mem/courses --origin https://a.example/path
! nexoctl: error: media protection: "https://a.example/path" is not an origin (https://host[:port])
! Run 'nexoctl media protection set --help' for usage.
[exit 2]

$ nexoctl media protection set mem/courses --pace 50
! nexoctl: error: media protection: paceFactor must be 1 to 20
! Run 'nexoctl media protection set --help' for usage.
[exit 2]

$ nexoctl media protection set mem/courses --mode drm
! nexoctl: error: media protection: mode must be standard or advanced
! Run 'nexoctl media protection set --help' for usage.
[exit 2]

$ nexoctl media token mem/courses/lessons/intro.mp4
! nexoctl: error: --subject is required: the viewer the token is for
! Run 'nexoctl media token --help' for usage.
[exit 2]

$ nexoctl media token mem/courses --subject s
! nexoctl: error: mem/courses: expected a video or an image (ALIAS/BUCKET/KEY)
! Run 'nexoctl media token --help' for usage.
[exit 2]

$ nexoctl media revoke mem/courses
! nexoctl: error: give exactly one of --session and --subject
! Run 'nexoctl media revoke --help' for usage.
[exit 2]

$ nexoctl media trace mem/courses/lessons/intro.mp4
! nexoctl: error: give exactly one of --votes and --bits
! Run 'nexoctl media trace --help' for usage.
[exit 2]

$ nexoctl media trace mem/courses/lessons/intro.mp4 --bits 01x2
! nexoctl: error: mem/courses/lessons/intro.mp4: invalid argument: the bits of a trace are 0, 1 and ? (got '2')
[exit 1]

$ nexoctl media protection set mem/courses --disable
Video protection of `mem/courses` disabled.

$ nexoctl media protection get mem/courses
Video protection of `mem/courses`: disabled.

