$ nexoctl media get mem/videos
`mem/videos` has no media rule.

$ nexoctl media set mem/videos media.json
Media rules of `mem/videos` set (1 rule).

$ nexoctl media get mem/videos
{
  "rules": [
    {
      "id": "courses",
      "prefix": "courses/",
      "suffixes": [
        ".m4v",
        ".mov",
        ".mp4"
      ],
      "renditions": [
        "720p",
        "480p"
      ],
      "poster": true
    }
  ]
}

$ nexoctl media get --json mem/videos
{"status":"success","target":"mem/videos","bucket":"videos","rules":[{"id":"courses","prefix":"courses/","suffixes":[".m4v",".mov",".mp4"],"renditions":["720p","480p"],"poster":true}]}

$ nexoctl media rule add mem/videos --id clips --suffix .MP4,.webm --thumbnails 5s
Media rule "clips" added to `mem/videos`.

$ nexoctl media rule add mem/videos --id courses --prefix courses/ --rendition 1080p --rendition 360p --json
{"status":"success","target":"mem/videos","bucket":"videos","id":"courses","prefix":"courses/","suffixes":[".m4v",".mov",".mp4"],"renditions":["1080p","360p"]}

$ nexoctl media get mem/videos
{
  "rules": [
    {
      "id": "courses",
      "prefix": "courses/",
      "suffixes": [
        ".m4v",
        ".mov",
        ".mp4"
      ],
      "renditions": [
        "1080p",
        "360p"
      ]
    },
    {
      "id": "clips",
      "suffixes": [
        ".mp4",
        ".webm"
      ],
      "thumbnails": {
        "interval": "5s"
      }
    }
  ]
}

$ nexoctl media rule rm mem/videos clips
Media rule "clips" removed from `mem/videos`.

$ nexoctl media reprocess mem/videos/courses/intro.mp4
