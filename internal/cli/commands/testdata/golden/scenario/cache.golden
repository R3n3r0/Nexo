--- cache.yaml
distribution: site
cache:
  autoInvalidate: false
domains:
  - host: www.site.test
    cache:
      policy: short
      quota: 64MiB
  - host: preview.site.test
    cache:
      enabled: false
behaviors:
  - pathPattern:
      type: glob
      pattern: /assets/**
    cache:
      ttl:
        default: 365d
        max: 365d
webhooks:
  - id: cloudflare
    type: cloudflare
    domains:
      - www.site.test
    zone: z1
    token: '********'
  - id: edge
    type: generic
    url: http://edge.test/purge
    headers:
      X-Token: abc
    body: '{"paths":"{{range .Paths}}{{.}} {{end}}"}'
warmOnWrite:
  - type: glob
    pattern: /assets/**

$ nexoctl cache policy export mem
name: short
comment: ten minutes
ttl:
  default: 10m
  max: 1d
browserCacheControl: public, max-age=600
cacheKey:
  queryString:
    mode: allowlist
    params:
      - v
      - lang
  headers:
    - Accept-Language
staleWhileRevalidate: 1m
negativeCaching: 30s
bypass:
  cookies:
    - session

$ nexoctl dist cache set mem site --domain www.site.test --reset
