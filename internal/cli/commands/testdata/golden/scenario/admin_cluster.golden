$ nexoctl admin cluster export mem --output backup.zip
Exported the state of "mem" to backup.zip (279B).

$ nexoctl admin cluster import mem backup.zip --dry-run
Would import into "mem" (merge): 1 user(s), 0 group(s), 0 polic(ies), 1 configuration subsystem(s), 0 bucket(s).

$ nexoctl admin cluster import mem backup.zip --mode replace --dry-run
Would import into "mem" (replace): 1 user(s), 0 group(s), 0 polic(ies), 1 configuration subsystem(s), 0 bucket(s).
Removed: user:mallory

$ nexoctl admin cluster import mem backup.zip --mode replace
Imported into "mem" (replace): 1 user(s), 0 group(s), 0 polic(ies), 1 configuration subsystem(s), 0 bucket(s).
Removed: user:mallory

$ nexoctl admin cluster import mem backup.zip --mode wipe
! nexoctl: error: --mode must be merge or replace, not "wipe"
! Run 'nexoctl admin cluster import --help' for usage.
[exit 2]

$ nexoctl admin cluster import mem junk.zip
! nexoctl: error: import junk.zip: invalid argument: cluster archive: not a zip file: zip: not a valid zip file (invalid_argument)
[exit 1]

$ nexoctl admin lock list mem
